        "step": "CHECKOUT_COMPLETION"
      },
      "cart": {
        "buyerIdentity": {
          "email": null,
          "phone": null,
          "isAuthenticated": false,
          "customer": {
            "id": "gid://shopify/Customer/1"
          }
        },
        "lines": [
          {
            "merchandise": {
              "__typename": "ProductVariant",
              "requiresShipping": true
            }
          }
        ],
        "deliveryGroups": [
          {
            "deliveryAddress": {
              "address1": "1 Main St",
              "phone": "+15555550100"
            },
            "selectedDeliveryOption": null
